FROM registry.access.redhat.com/ubi8/openjdk-21-runtime
VOLUME /tmp

WORKDIR /app
COPY target/*.jar /app/mirrorservice.jar

# 8003 = server.port (API), 8081 = management.server.port (Actuator: Probes, Prometheus)
EXPOSE 8003 8081

ENTRYPOINT ["java", "-Djava.security.egd=file:/dev/./urandom", "-jar", "/app/mirrorservice.jar"]
